flowchart TD
  SRC[Approved live/fixture input] --> INGEST[accounting.ledger.ingest]
  INGEST --> LEDGER[ledger_canonical.csv]
  INGEST --> ALLSTATUS[ledger_canonical_all_status.csv]

  LEDGER --> MAT[governed materialization]
  MAT --> SEM[monthly_flow_semantic_split.csv]
  MAT --> OPS[monthly_operating_statement.csv + QA]
  MAT --> CASH[monthly_cash_close.csv + QA]
  MAT --> DIAG[Stage-D diagnostic/internal evidence]

  ALLSTATUS --> DEBTENG[accounting.debt.resolve + balance_views]
  DEBTENG --> DEBTEVID[open items / allocations / repayment / balance evidence]
  DEBTEVID --> DEBTMART[accounting.marts.debt]
  DEBTMART --> DEBTPOS[monthly_debt_position.csv + QA]
  DEBTMART --> DEBTACT[monthly_debt_activity.csv + QA]
  DEBTPOS --> TREAS[treasury/accountability]
  DEBTACT --> TREAS

  SEM --> FRONTIER[accounting.metrics.frontier]
  OPS --> FRONTIER
  CASH --> FRONTIER
  DEBTPOS --> FRONTIER
  DEBTACT --> FRONTIER
  FRONTIER --> MCONTRACT[metric_contract_frontier.csv]
  FRONTIER --> MSERIES[frontend_metric_series.csv]

  FRONTIER --> ANNUAL[accounting.metrics.annual]
  ANNUAL --> ADASH[annual dashboard metrics + contract + QA]
  ANNUAL --> MEMBERS[annual_flow_membership.csv]

  MCONTRACT --> PUB[accounting.publish.latest]
  MSERIES --> PUB
  ADASH --> PUB
  SEM --> PUB
  OPS --> PUB
  CASH --> PUB
  DEBTPOS --> PUB
  DEBTACT --> PUB
  PUB --> BUNDLE[public/accounting/latest_SCOPE/ accounting_public_bundle.v1]

  FRONTIER --> PROF[professional pack / governed drilldowns]
  ANNUAL --> PROF
  MEMBERS --> PROF

  DIAG -. audit only .-> PROF
  DEBTEVID -. audit only / unsafe for frontend .-> PROF
